# Optional VWorld key for geocoding, map tiles, and cadastral boundary lookup.
GAMJEONG_VWORLD_KEY=

# Optional public-price/standard-parcel API key.
GAMJEONG_INDVD_KEY=

# Optional MOLIT RTMS/data.go.kr key for land trade cases.
GAMJEONG_RTMS_KEY=

# Optional existing Gamjeong app path used for comparison-standard history.
GAMJEONG_DIR=~/Documents/gamjeong

# Folder where the final Word file is saved (default: ~/Documents/Codex/지적도 자료).
MAP_PHOTO_WORD_DIR=
